MYSQL_PASSWORD=

# 데이터베이스 설정 (MySQL)

# 도커에서 mysql 열었을 경우에는 host.docker.internal
MYSQL_HOST=localhost
MYSQL_PORT=3306

MYSQL_ROOT_PASSWORD=
DB_USERNAME=
DB_PASSWORD=your_secure_db_password_here
MYSQL_DATABASE_NAME=

# AWS 서비스 설정
AWS_REGION=ap-northeast-2

# S3 버킷 설정
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your-capstone-bucket

# JWT 보안 설정
JWT_SECRET=your_super_secret_jwt_key_min_256_bits_long_for_security
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_PASSWORD_RESET_EXPIRATION=600000

# 이메일 설정
MAIL_USERNAME=
MAIL_PASSWORD=

# ------------------------------------------
# FastAPI 챗봇 서비스 설정
# ------------------------------------------
# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=120

# 챗봇 기능 설정
CHATBOT_MAX_MESSAGES_HISTORY=8